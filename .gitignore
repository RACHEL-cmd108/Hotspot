# macOS and editor metadata
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Python caches and local environments
__pycache__/
*.py[cod]
.venv/
venv/

# Secrets and local configuration
.env
.env.*
!.env.example
*.key
*.pem

# Temporary and generated files
tmp/
*.tmp
*.temp
~$*
workspace/

# Local document version archives (never sync to remote)
**/archive/
**/archive/**

# Local Codex/BMad installations and generated output
.agents/
_bmad/render/**
!_bmad/render/.gitignore
_bmad/config.user.toml
_bmad/custom/config.user.toml
_bmad-output/*
!_bmad-output/README.md

# Canonical SPEC deliverables (track only the index and one SPEC.md per topic)
!_bmad-output/specs/
_bmad-output/specs/*
!_bmad-output/specs/README.md
!_bmad-output/specs/spec-*/
_bmad-output/specs/spec-*/*
!_bmad-output/specs/spec-*/SPEC.md
